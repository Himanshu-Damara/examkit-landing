# Public canonical URL used by metadata, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: the official Microsoft Edge Add-ons URL for ExamKit.
# Leave empty until the listing is live. The install CTAs stay safely disabled
# rather than showing a fabricated or broken destination.
NEXT_PUBLIC_EXAMKIT_LISTING_URL=

# Optional: a verified Google Drive or other release URL for the download CTA.
# Keep empty until the package is ready to publish.
NEXT_PUBLIC_EXAMKIT_DOWNLOAD_URL=
